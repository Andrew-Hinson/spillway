    {
      "id": 14,
      "type": "timeseries",
      "title": "Feeder stream reconnects",
      "description": "Reconnects per 5 minutes. Wikimedia closes healthy connections about every 15 minutes, so occasional bars are normal.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(spillway_feeder_stream_reconnects_total[5m]))",
          "legendFormat": "Reconnects",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
