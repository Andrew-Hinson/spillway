          "expr": "(sum by (team) (rate(vector_component_sent_event_bytes_total{team!=\"\",component_id=~\".+_hot\"}[$__range])) or label_replace(sum(rate(vector_component_received_event_bytes_total{component_id=~\"loki|loki_pods\"}[$__range])), \"team\", \"(unclaimed)\", \"\", \"\")) * 2592000 / 1e9 * $hot_price",
          "refId": "E",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
