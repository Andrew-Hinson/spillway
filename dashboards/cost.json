{
  "uid": "spillway-cost",
  "title": "Spillway cost",
  "description": "Volume and estimated cost per team, hot vs cold. Prices are editable defaults, not quotes: check your provider's current pricing.",
  "tags": [
    "spillway"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "hot_price",
        "label": "Hot $ / GB ingested",
        "query": "0.50",
        "current": {
          "text": "0.50",
          "value": "0.50"
        },
        "options": [
          {
            "selected": true,
            "text": "0.50",
            "value": "0.50"
          }
        ],
        "description": "Price per GB (10^9 bytes) ingested into hot storage. Default: a typical hosted-Loki list price.",
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "cold_price",
        "label": "Cold $ / GB-month",
        "query": "0.023",
        "current": {
          "text": "0.023",
          "value": "0.023"
        },
        "options": [
          {
            "selected": true,
            "text": "0.023",
            "value": "0.023"
          }
        ],
        "description": "Price per GB stored per month in cold storage. Default: a typical S3 Standard list price.",
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "cold_retention_months",
        "label": "Cold retention (months)",
        "query": "12",
        "current": {
          "text": "12",
          "value": "12"
        },
        "options": [
          {
            "selected": true,
            "text": "12",
            "value": "12"
          }
        ],
        "description": "How long cold data is kept. Cold cost shown is steady state: a month's data times this many months stored.",
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Estimated cost / month",
      "description": "Hot plus cold, every team and unclaimed data, at the selected range's average rate and the prices set above.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum((sum by (team) (rate(vector_component_sent_event_bytes_total{team!=\"\",component_id=~\".+_hot\"}[$__range])) or label_replace(sum(rate(vector_component_received_event_bytes_total{component_id=~\"loki|loki_pods\"}[$__range])), \"team\", \"(unclaimed)\", \"\", \"\")) * 2592000 / 1e9 * $hot_price) + (sum(sum by (team) (rate(vector_component_sent_event_bytes_total{team!=\"\",component_id=~\".+_cold\"}[$__range])) * 2592000 / 1e9 * scalar(sum(rate(vector_component_sent_bytes_total{component_id=\"cold_s3\"}[$__range])) / sum(rate(vector_component_received_event_bytes_total{component_id=\"cold_s3\"}[$__range]))) * $cold_price * $cold_retention_months) or vector(0))",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Hot volume / day",
      "description": "Event bytes into Loki per day (team pipelines and unclaimed data), at the selected range's average rate. Hosted Loki is priced on ingested bytes like these.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum((sum by (team) (rate(vector_component_sent_event_bytes_total{team!=\"\",component_id=~\".+_hot\"}[$__range])) or label_replace(sum(rate(vector_component_received_event_bytes_total{component_id=~\"loki|loki_pods\"}[$__range])), \"team\", \"(unclaimed)\", \"\", \"\"))) * 86400",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cold stored / day",
      "description": "Gzip bytes written to cold storage per day: event bytes into the per-team cold stages times the cold sink's measured compression ratio.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(sum by (team) (rate(vector_component_sent_event_bytes_total{team!=\"\",component_id=~\".+_cold\"}[$__range]))) or vector(0)) * 86400 * scalar(sum(rate(vector_component_sent_bytes_total{component_id=\"cold_s3\"}[$__range])) / sum(rate(vector_component_received_event_bytes_total{component_id=\"cold_s3\"}[$__range])))",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cold compression",
      "description": "Bytes the cold sink uploaded over the event bytes it took in (gzip JSON lines), over the selected range.",
