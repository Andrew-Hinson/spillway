          "expr": "sum by (team) (rate(vector_component_sent_event_bytes_total{team!=\"\",component_id=~\".+_cold\"}[$__range])) * 2592000 / 1e9 * scalar(sum(rate(vector_component_sent_bytes_total{component_id=\"cold_s3\"}[$__range])) / sum(rate(vector_component_received_event_bytes_total{component_id=\"cold_s3\"}[$__range]))) * $cold_price * $cold_retention_months",
