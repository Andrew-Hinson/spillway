      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (team) (rate(vector_component_received_event_bytes_total{team!=\"\",component_id=~\".+_ids\"}[$__range])) or label_replace(sum(rate(vector_component_received_event_bytes_total{component_id=~\"loki|loki_pods\"}[$__range])), \"team\", \"(unclaimed)\", \"\", \"\")) * 86400",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (team) (rate(vector_component_sent_event_bytes_total{team!=\"\",component_id=~\".+_hot\"}[$__range])) or label_replace(sum(rate(vector_component_received_event_bytes_total{component_id=~\"loki|loki_pods\"}[$__range])), \"team\", \"(unclaimed)\", \"\", \"\")) * 86400",
